# Meta Model API (Muse). Leave MODEL_API_KEY empty to run in deterministic manual mode.
MODEL_API_KEY=
MODEL_ID=muse-wonder-1.0
MODEL_API_BASE=https://api.meta.ai/v1
MODEL_API_FORMAT=responses
MODEL_REASONING_EFFORT=low
MODEL_TIMEOUT_S=90
MODEL_MAX_IMAGE_MB=8

# Where saved estimates and material prices are written
GFPF_DATA_PATH=data/estimates.json
GFPF_RATES_PATH=data/rates.json
